/*
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.firebaseio.com https://*.firebasedatabase.app https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff

/styles.css
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff

/script.js
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff

/firebase-config.js
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff

/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff
